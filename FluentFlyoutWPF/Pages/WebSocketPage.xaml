<Page x:Class="FluentFlyoutWPF.Pages.WebSocketPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:viewModels="clr-namespace:FluentFlyoutWPF.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="600"
      Title="WebSocket"
      d:DataContext="{d:DesignInstance viewModels:UserSettings}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      d:Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" Margin="16">
            <TextBlock Text="WebSocket" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Expose your current media session to OBS Browser Sources using a local WebSocket connection."
                       FontSize="13" Opacity="0.65" Margin="0,6,0,24" TextWrapping="Wrap" />

            <TextBlock Text="Connection" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ui:CardControl Tag="Indexable" Icon="{ui:SymbolIcon Globe24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Enable WebSocket server" FontSize="14" />
                        <TextBlock Text="Run the local HTTP and WebSocket service for OBS." FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ObsNowPlayingEnabled, Mode=TwoWay}" />
            </ui:CardControl>

            <ui:CardControl Tag="Indexable" Icon="{ui:SymbolIcon PlugConnected24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Local service port" FontSize="14" />
                        <TextBlock Text="Changing the port restarts the server. Allowed range: 1024–65535." FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <TextBox Text="{Binding ObsNowPlayingPort, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Width="110" HorizontalContentAlignment="Right"
                         VerticalContentAlignment="Center" Padding="8,4"
                         ToolTip="Default: 17832" />
            </ui:CardControl>

            <ui:CardControl Tag="Indexable" Icon="{ui:SymbolIcon MusicNote2Play20}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Media source" FontSize="14" />
                        <TextBlock Text="Choose which SMTC player is sent to OBS. Automatic follows FluentFlyout." FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="MediaSourceComboBox" SelectionChanged="MediaSourceComboBox_SelectionChanged"
                          MinWidth="220" />
            </ui:CardControl>

            <TextBlock Text="HTML theme" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,8" />
            <ui:CardControl Tag="Indexable" Icon="{ui:SymbolIcon Code24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Selected HTML template" FontSize="14" />
                        <TextBlock Text="Choose an HTML file from a theme subfolder. The selector shows its folder name." FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged"
                          MinWidth="220" />
            </ui:CardControl>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <ui:Button Content="Refresh themes" Icon="{ui:SymbolIcon ArrowSync24}" Click="RefreshThemes_Click" Margin="0,0,8,0" />
                <ui:Button Content="Open theme folder" Icon="{ui:SymbolIcon FolderOpen24}" Click="OpenThemeFolder_Click" />
            </StackPanel>

            <TextBlock x:Name="ThemeFolderText" FontSize="11" Opacity="0.6" Margin="4,8,0,16" TextWrapping="Wrap" />

            <TextBlock Text="OBS Browser Source" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8" />
            <ui:CardControl Tag="Indexable" Icon="{ui:SymbolIcon Link24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Browser Source URL" FontSize="14" />
                        <TextBlock x:Name="BrowserSourceUrlText" Text="{Binding ObsNowPlayingPort, StringFormat='http://127.0.0.1:{0}/'}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Copy URL" Icon="{ui:SymbolIcon Copy24}" Click="CopyUrl_Click" />
            </ui:CardControl>

            <TextBlock Text="Create a folder for each theme category and place one or more HTML files and their supporting assets inside it. Relative asset paths are resolved from the selected HTML file’s folder. Include /js/fluentflyout-api.js and subscribe with FluentFlyout.onMediaChanged(callback). Only use trusted HTML/JavaScript files."
                       FontSize="12" Opacity="0.6" Margin="4,12,0,36" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
